# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Prisma - read from prisma/schema.prisma's env("DATABASE_URL"))
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scanserve?schema=public
=postgresql://postgres:NewStrongPassword123!@localhost:5432/Qrcode?schema=public
# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS - also used for Socket.IO's CORS config (Phase 7); see lib/socket.js
CLIENT_ORIGIN=http://localhost:3000

# Used to build customer menu URLs for QR codes: <FRONTEND_URL>/menu/<slug>
# Point this at wherever `flutter run -d chrome` / your deployed web build
# is served - never hardcode a production domain.
FRONTEND_URL=http://localhost:3000

# Used only by scripts/seedSuperAdmin.js (npm run seed:super-admin) to
# create the first Super Admin account. Not read by the running server.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Cloudinary - used to store menu item images (Phase 4). Never commit
# real values here; get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Phase 8 - Order Notifications)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
